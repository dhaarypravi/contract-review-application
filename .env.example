# Copy to .env and fill in the keys marked REQUIRED. Never commit .env.

# --- Clerk (REQUIRED) ---------------------------------------------------------
# https://dashboard.clerk.com -> your application -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: Clerk's public key (PEM), to check tokens without a network call.
CLERK_JWT_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Port on your machine, and the origin Clerk tokens must be issued for.
# Change both together, e.g. 3100 and http://localhost:3100
WEB_PORT=3000
APP_URL=http://localhost:3000

# --- Model provider: gemini (default) or openrouter ---------------------------
# gemini:     key from https://aistudio.google.com/apikey  (free, no card)
# openrouter: key from https://openrouter.ai/keys          (free models: 50 requests/day)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides. Leave blank for the provider's default.
# Changing the embedding model or width deletes stored vectors on the next migrate.
CHAT_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
LLM_BASE_URL=

# --- Infrastructure (used when running on the host; compose sets its own) -------
POSTGRES_PORT=5433
REDIS_PORT=6380
DATABASE_URL=postgres://postgres:postgres@localhost:5433/contract_review
REDIS_URL=redis://localhost:6380
UPLOAD_DIR=./data/uploads
